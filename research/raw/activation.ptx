.version 7.5
.target sm_75
.address_size 64
.visible .entry ActivationKernel(
    .param .u64 param_buf,
    .param .u32 param_n
)
{
    .reg .b32 %r<10>;
    .reg .b64 %rd<10>;
    .reg .f32 %f<5>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [param_buf];
    ld.param.u32 %r1, [param_n];

    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mov.u32 %r4, %tid.x;
    mad.lo.u32 %r5, %r2, %r3, %r4;

    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra EXIT;

    mul.wide.u32 %rd2, %r5, 4;
    add.u64 %rd3, %rd1, %rd2;
    ld.global.f32 %f1, [%rd3];
    mul.f32 %f2, %f1, 1.0001;
    st.global.f32 [%rd3], %f2;

EXIT:
    ret;
}