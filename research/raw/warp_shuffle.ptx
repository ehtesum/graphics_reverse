.version 7.5
.target sm_75
.address_size 64

// Pure XOR Shuffle Kernel
.visible .entry ShuffleXOR(
    .param .u64 d_out_cycles,
    .param .u64 d_out_val,
    .param .u32 delta
) {
    .reg .u64 %ptr_out, %ptr_val;
    .reg .u32 %tidx, %delta, %val, %mask, %w_size;
    .reg .u64 %t0, %t1, %dt;
    .reg .pred %p_dummy, %p0;

    ld.param.u64 %ptr_out, [d_out_cycles];
    ld.param.u64 %ptr_val, [d_out_val];
    ld.param.u32 %delta, [delta];
    mov.u32 %tidx, %tid.x;
    mov.u32 %mask, 0xffffffff;
    mov.u32 %w_size, 31;
    mov.u32 %val, %tidx;

    bar.sync 0;
    mov.u64 %t0, %clock64;

    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
