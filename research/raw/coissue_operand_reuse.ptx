  add.s32 %r3, %r3, 1;
  fma.rn.f32 %f0, %f0, %f0, 0.0001;
  add.s32 %r3, %r3, 1;
  add.u32 %r10, %r10, 1;
  setp.lt.u32 %p1, %r10, %r1;
  @%p1 bra LOOP;
  cvt.rn.f32.s32 %f1, %r3;
  add.f32 %f0, %f0, %f1;
  st.global.f32 [%rd3], %f0;
