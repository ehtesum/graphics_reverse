  add.s64 %rd3, %rd1, %rd2;
  ld.global.f32 %f0, [%rd3];
  cvt.rzi.s32.f32 %r3, %f0;
  mov.u32 %r10, 0;
LOOP:
  fma.rn.f32 %f0, %f0, %f0, 0.0001;
  add.s32 %r3, %r3, 1;
  fma.rn.f32 %f0, %f0, %f0, 0.0001;
  add.s32 %r3, %r3, 1;
  fma.rn.f32 %f0, %f0, %f0, 0.0001;
  add.s32 %r3, %r3, 1;
