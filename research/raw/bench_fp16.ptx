    fma.rn.f16x2 %h2, %h2, %mul, %add;
    fma.rn.f16x2 %h3, %h3, %mul, %add;
    fma.rn.f16x2 %h4, %h4, %mul, %add;
    fma.rn.f16x2 %h5, %h5, %mul, %add;
    fma.rn.f16x2 %h6, %h6, %mul, %add;
    fma.rn.f16x2 %h7, %h7, %mul, %add;
    add.u32 %k, %k, 1;
    setp.lt.u32 %p_loop, %k, %limit;
    @%p_loop bra $loop_f16;

    add.f16x2 %h0, %h0, %h1; add.f16x2 %h2, %h2, %h3;
    add.f16x2 %h4, %h4, %h5; add.f16x2 %h6, %h6, %h7;
    add.f16x2 %h0, %h0, %h2; add.f16x2 %h4, %h4, %h6;
    add.f16x2 %h0, %h0, %h4;
    setp.eq.u32 %p0, %tidx, 0;
    @%p0 st.global.u32 [%out_ptr], %h0;
    ret;
}