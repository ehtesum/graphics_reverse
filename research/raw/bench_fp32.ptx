.version 7.5
.target sm_75
.address_size 64

.visible .entry BenchFP32(
    .param .u64 d_out,
    .param .u32 iters
) {
    .reg .u64 %out_ptr;
    .reg .u32 %tidx, %k, %limit;
    .reg .f32 %a0, %a1, %a2, %a3, %a4, %a5, %a6, %a7;
    .reg .f32 %mul, %add;
    .reg .pred %p_loop, %p0;

    ld.param.u64 %out_ptr, [d_out];
    ld.param.u32 %limit, [iters];
    mov.u32 %tidx, %tid.x;

    mov.f32 %a0, 1.0; mov.f32 %a1, 1.1; mov.f32 %a2, 1.2; mov.f32 %a3, 1.3;
    mov.f32 %a4, 1.4; mov.f32 %a5, 1.5; mov.f32 %a6, 1.6; mov.f32 %a7, 1.7;
    mov.f32 %mul, 1.0001; mov.f32 %add, 0.0001;
    mov.u32 %k, 0;

    $loop_f32:
    fma.rn.f32 %a0, %a0, %mul, %add;
    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
    fma.rn.f32 %a7, %a7, %mul, %add;
    fma.rn.f32 %a0, %a0, %mul, %add;
    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
    fma.rn.f32 %a7, %a7, %mul, %add;
    fma.rn.f32 %a0, %a0, %mul, %add;
    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
    fma.rn.f32 %a7, %a7, %mul, %add;
    fma.rn.f32 %a0, %a0, %mul, %add;
    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
    fma.rn.f32 %a7, %a7, %mul, %add;
    fma.rn.f32 %a0, %a0, %mul, %add;
    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
    fma.rn.f32 %a7, %a7, %mul, %add;
    fma.rn.f32 %a0, %a0, %mul, %add;
    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
    fma.rn.f32 %a7, %a7, %mul, %add;
    fma.rn.f32 %a0, %a0, %mul, %add;
    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
    fma.rn.f32 %a7, %a7, %mul, %add;
    fma.rn.f32 %a0, %a0, %mul, %add;
    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
    fma.rn.f32 %a7, %a7, %mul, %add;
    fma.rn.f32 %a0, %a0, %mul, %add;
    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
    fma.rn.f32 %a7, %a7, %mul, %add;
    fma.rn.f32 %a0, %a0, %mul, %add;
    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
    fma.rn.f32 %a7, %a7, %mul, %add;
    fma.rn.f32 %a0, %a0, %mul, %add;
    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
