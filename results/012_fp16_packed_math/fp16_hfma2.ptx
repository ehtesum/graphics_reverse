.version 7.5
.target sm_75
.address_size 64
.visible .entry BenchmarkFP16(
    .param .u64 param_arr,
    .param .u32 param_iters
)
{
    .reg .b32 %r<10>;
    .reg .b32 %h<20>;
    .reg .b64 %rd<10>;
    .reg .pred %p<4>;

    ld.param.u64 %rd1, [param_arr];
    ld.param.u32 %r1, [param_iters];
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mov.u32 %r4, %tid.x;
    mad.lo.s32 %r5, %r2, %r3, %r4;

    mul.wide.s32 %rd2, %r5, 4;
    add.s64 %rd3, %rd1, %rd2;
    ld.global.u32 %h1, [%rd3];
    // 0x3C00 is 1.0 in FP16; packed two 1.0f16 is 0x3C003C00
    mov.b32 %h2, 0x3C003C00;
    // 0x3800 is 0.5 in FP16; packed two 0.5f16 is 0x38003800
    mov.b32 %h3, 0x38003800;
    mov.b32 %h4, %h1;
    mov.b32 %h5, %h1;

    mov.u32 %r6, 0;
LOOP:
    setp.ge.u32 %p1, %r6, %r1;
    @%p1 bra DONE;

    fma.rn.f16x2 %h4, %h4, %h2, %h3;
    fma.rn.f16x2 %h5, %h5, %h2, %h3;
