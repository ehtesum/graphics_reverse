.version 7.5
.target sm_75
.address_size 64
.visible .entry DivergenceKernel_P2(
    .param .u64 param_out,
    .param .u32 param_iters
)
{
    .reg .b32 %r<35>;
    .reg .b64 %rd<5>;
    .reg .pred %p<35>;

    ld.param.u64 %rd1, [param_out];
    ld.param.u32 %r1, [param_iters];
    mov.u32 %r2, %tid.x;

    // Determine path ID (0 to 1)
    rem.u32 %r3, %r2, 2;
    mov.u32 %r10, 1;
    mov.u32 %r20, 0;

LOOP:
    setp.eq.u32 %p0, %r3, 0;
    @%p0 bra PATH_0;
    setp.eq.u32 %p1, %r3, 1;
    @%p1 bra PATH_1;
    bra END_PATHS;
PATH_0:
    // Workload for Path 0 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 1;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 2;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 3;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 4;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_1:
    // Workload for Path 1 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 2;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 3;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 4;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 5;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
END_PATHS:
    add.u32 %r20, %r20, 1;
    setp.lt.u32 %p34, %r20, %r1;
    @%p34 bra LOOP;

    mul.wide.u32 %rd2, %r2, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r10;
    ret;
}