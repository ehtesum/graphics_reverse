.version 7.5
.target sm_75
.address_size 64
.visible .entry SmemSweepKernel(.param .u64 param_arr, .param .u32 param_iters) {
  .shared .align 4 .b8 smem[16384];
  .reg .b32 %r<20>;
  .reg .b64 %rd<20>;
  .reg .f32 %f<10>;
  .reg .pred %p<2>;
  ld.param.u64 %rd1, [param_arr];
  ld.param.u32 %r1, [param_iters];
  mov.u32 %r2, %tid.x;
  mul.lo.u32 %r3, %r2, 1;
  and.b32 %r4, %r3, 16383;
  mul.wide.u32 %rd2, %r4, 1;
  mov.u64 %rd3, smem;
  add.s64 %rd4, %rd3, %rd2;
  mov.u32 %r5, 0;
LOOP:
  st.shared.u8 [%rd4], %r6;
  st.shared.u8 [%rd4], %r6;
  st.shared.u8 [%rd4], %r6;
  st.shared.u8 [%rd4], %r6;
  add.u32 %r5, %r5, 1;
  setp.lt.u32 %p1, %r5, %r1;
  @%p1 bra LOOP;
  bar.sync 0;
  mul.wide.u32 %rd5, %r2, 4;
  add.s64 %rd6, %rd1, %rd5;
  st.global.u32 [%rd6], %r7;
  ret;
}