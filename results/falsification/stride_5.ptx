.version 7.5
.target sm_75
.address_size 64
.visible .entry BankFalsify(.param .u64 param_arr, .param .u32 param_iters) {
  .shared .f32 smem[4096];
  .reg .b32 %r<15>;
  .reg .f32 %f<10>;
  .reg .b64 %rd<5>;
  .reg .pred %p<2>;
  ld.param.u64 %rd1, [param_arr];
  ld.param.u32 %r1, [param_iters];
  mov.u32 %r2, %tid.x;
  mul.lo.u32 %r3, %r2, 5;
  and.b32 %r4, %r3, 4095;
  mul.wide.u32 %rd2, %r4, 4;
  mov.u64 %rd3, smem;
  add.s64 %rd4, %rd3, %rd2;
  mov.f32 %f1, 1.0;
  st.shared.f32 [%rd4], %f1;
  bar.sync 0;
  mov.u32 %r5, 0;
LOOP:
  ld.shared.f32 %f2, [%rd4];
  add.f32 %f2, %f2, 0.001;
  st.shared.f32 [%rd4], %f2;
  ld.shared.f32 %f2, [%rd4];
  add.f32 %f2, %f2, 0.001;
  st.shared.f32 [%rd4], %f2;
  add.u32 %r5, %r5, 1;
  setp.lt.u32 %p1, %r5, %r1;
  @%p1 bra LOOP;
  bar.sync 0;
  mul.wide.u32 %rd2, %r2, 4;
  add.s64 %rd3, %rd1, %rd2;
  st.global.f32 [%rd3], %f2;
  ret;
}