.version 7.5
.target sm_75
.address_size 64

.visible .entry _Z4testPf(
    .param .u64 _Z4testPf_param_0
)
{
    .reg .b32   %r<10>;
    .reg .f32   %f<3>;
    .reg .b64   %rd<6>;

    ld.param.u64    %rd1, [_Z4testPf_param_0];
    mov.u32         %r1, %ctaid.x;
    mov.u32         %r2, %ntid.x;
    mov.u32         %r3, %tid.x;
    mad.lo.s32      %r4, %r1, %r2, %r3; // i

    // Strided index: (i * 32) % 1048576 = (i << 5) & 0xFFFFF
    shl.b32         %r5, %r4, 5;
    and.b32         %r6, %r5, 0x000FFFFF; // wrap around 1M elements

    mul.wide.s32    %rd2, %r6, 4;
    add.s64         %rd3, %rd1, %rd2;

    ld.global.f32   %f1, [%rd3];
    add.f32         %f2, %f1, 0f3F800000; // + 1.0f
    st.global.f32   [%rd3], %f2;
    ret;
}
