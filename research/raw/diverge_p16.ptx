.version 7.5
.target sm_75
.address_size 64
.visible .entry DivergenceKernel_P16(
    .param .u64 param_out,
    .param .u32 param_iters
)
{
    .reg .b32 %r<35>;
    .reg .b64 %rd<5>;
    .reg .pred %p<35>;

    ld.param.u64 %rd1, [param_out];
    ld.param.u32 %r1, [param_iters];
    mov.u32 %r2, %tid.x;

    // Determine path ID (0 to 15)
    rem.u32 %r3, %r2, 16;
    mov.u32 %r10, 1;
    mov.u32 %r20, 0;

LOOP:
    setp.eq.u32 %p0, %r3, 0;
    @%p0 bra PATH_0;
    setp.eq.u32 %p1, %r3, 1;
    @%p1 bra PATH_1;
    setp.eq.u32 %p2, %r3, 2;
    @%p2 bra PATH_2;
    setp.eq.u32 %p3, %r3, 3;
    @%p3 bra PATH_3;
    setp.eq.u32 %p4, %r3, 4;
    @%p4 bra PATH_4;
    setp.eq.u32 %p5, %r3, 5;
    @%p5 bra PATH_5;
    setp.eq.u32 %p6, %r3, 6;
    @%p6 bra PATH_6;
    setp.eq.u32 %p7, %r3, 7;
    @%p7 bra PATH_7;
    setp.eq.u32 %p8, %r3, 8;
    @%p8 bra PATH_8;
    setp.eq.u32 %p9, %r3, 9;
    @%p9 bra PATH_9;
    setp.eq.u32 %p10, %r3, 10;
    @%p10 bra PATH_10;
    setp.eq.u32 %p11, %r3, 11;
    @%p11 bra PATH_11;
    setp.eq.u32 %p12, %r3, 12;
    @%p12 bra PATH_12;
    setp.eq.u32 %p13, %r3, 13;
    @%p13 bra PATH_13;
    setp.eq.u32 %p14, %r3, 14;
    @%p14 bra PATH_14;
    setp.eq.u32 %p15, %r3, 15;
    @%p15 bra PATH_15;
    bra END_PATHS;
PATH_0:
    // Workload for Path 0 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 1;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 2;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 3;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 4;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_1:
    // Workload for Path 1 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 2;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 3;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 4;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 5;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_2:
    // Workload for Path 2 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 3;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 4;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 5;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 6;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_3:
    // Workload for Path 3 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 4;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 5;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 6;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 7;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_4:
    // Workload for Path 4 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 5;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 6;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 7;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 8;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_5:
    // Workload for Path 5 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 6;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 7;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 8;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 9;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_6:
    // Workload for Path 6 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 7;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 8;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 9;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 10;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_7:
    // Workload for Path 7 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 8;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 9;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 10;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 11;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_8:
    // Workload for Path 8 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 9;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 10;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 11;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 12;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_9:
    // Workload for Path 9 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 10;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 11;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 12;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 13;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_10:
    // Workload for Path 10 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 11;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 12;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 13;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 14;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_11:
    // Workload for Path 11 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 12;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 13;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 14;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 15;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_12:
    // Workload for Path 12 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 13;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 14;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 15;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 16;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_13:
    // Workload for Path 13 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 14;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 15;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 16;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 17;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_14:
    // Workload for Path 14 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 15;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 16;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 17;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 18;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
PATH_15:
    // Workload for Path 15 (16 unrolled ALU math ops)
    add.u32 %r10, %r10, 16;
    mul.lo.u32 %r10, %r10, 3;
    add.u32 %r10, %r10, 17;
    mul.lo.u32 %r10, %r10, 5;
    add.u32 %r10, %r10, 18;
    mul.lo.u32 %r10, %r10, 7;
    add.u32 %r10, %r10, 19;
    mul.lo.u32 %r10, %r10, 11;
    bra END_PATHS;
END_PATHS:
    add.u32 %r20, %r20, 1;
    setp.lt.u32 %p34, %r20, %r1;
    @%p34 bra LOOP;

    mul.wide.u32 %rd2, %r2, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r10;
    ret;
}