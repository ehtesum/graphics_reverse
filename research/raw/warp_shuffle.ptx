    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
    shfl.sync.bfly.b32 %val|%p_dummy, %val, %delta, %w_size, %mask;
