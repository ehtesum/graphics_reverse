    fma.rn.f32 %a1, %a1, %mul, %add;
    fma.rn.f32 %a2, %a2, %mul, %add;
    fma.rn.f32 %a3, %a3, %mul, %add;
    fma.rn.f32 %a4, %a4, %mul, %add;
    fma.rn.f32 %a5, %a5, %mul, %add;
    fma.rn.f32 %a6, %a6, %mul, %add;
    fma.rn.f32 %a7, %a7, %mul, %add;
    add.u32 %k, %k, 1;
    setp.lt.u32 %p_loop, %k, %limit;
    @%p_loop bra $loop_f32;

    add.f32 %a0, %a0, %a1; add.f32 %a2, %a2, %a3;
    add.f32 %a4, %a4, %a5; add.f32 %a6, %a6, %a7;
    add.f32 %a0, %a0, %a2; add.f32 %a4, %a4, %a6;
    add.f32 %a0, %a0, %a4;
    setp.eq.u32 %p0, %tidx, 0;
    @%p0 st.global.f32 [%out_ptr], %a0;
    ret;
}