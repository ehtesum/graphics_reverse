.version 7.5
.target sm_75
.address_size 64
.visible .entry AtomicContentionKernel(.param .u64 param_arr, .param .u32 param_iters) {
  .reg .b32 %r<15>;
  .reg .b64 %rd<10>;
  .reg .pred %p<2>;
  ld.param.u64 %rd1, [param_arr];
  ld.param.u32 %r1, [param_iters];
  mov.u32 %r2, %tid.x;
  and.b32 %r3, %r2, 511;
  mul.wide.u32 %rd2, %r3, 4;
  add.s64 %rd3, %rd1, %rd2;
  mov.u32 %r4, 0;
LOOP:
  atom.global.cas.b32 %r5, [%rd3], 0, 1;
  atom.global.cas.b32 %r5, [%rd3], 0, 1;
  atom.global.cas.b32 %r5, [%rd3], 0, 1;
  atom.global.cas.b32 %r5, [%rd3], 0, 1;
  add.u32 %r4, %r4, 1;
  setp.lt.u32 %p1, %r4, %r1;
  @%p1 bra LOOP;
  ret;
}